# Copiar como .env y ajustar.

# Motor de base de datos: sqlite (por defecto, no requiere instalación) o mysql
DB_CLIENT=sqlite
SQLITE_PATH=data/taller-cifrado.db

# Solo si DB_CLIENT=mysql (antes ejecutar database/schema.mysql.sql)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=taller_cifrado

# Factor de costo de BCrypt (2^10 = 1.024 rondas)
BCRYPT_SALT_ROUNDS=10

# Protección contra fuerza bruta
MAX_INTENTOS=5
VENTANA_MINUTOS=15
BLOQUEO_MINUTOS=15

# Sesión
SESION_HORAS=2

# --- Taller de certificados SSL -------------------------------------------
# Dominio publico del sitio.
DOMINIO=santafe-pineda.shop
# Numero de proxies inversos delante (nginx = 1; 0 si la app se expone sola).
# Necesario para que req.secure y req.ip sean fiables detras de nginx.
CONFIAR_EN_PROXY=1
# COOKIE_SECURE y FORZAR_HTTPS NO se fijan aqui. Son variables de etapa: la
# etapa 1 del taller necesita servir en claro y las etapas 2 y 3 necesitan
# https. Las gobierna la unidad de systemd, que las activa cuando el guion del
# certificado autofirmado crea taller-cifrado.service.d/https.conf.
# Solo tienen sentido aqui si la aplicacion se ejecuta a mano, sin systemd:
#   COOKIE_SECURE=false
#   FORZAR_HTTPS=false
