# /etc/systemd/system/taller-cifrado.service
#
# Aplicacion Angular SSR del Taller de Cifrado Clasico. Escucha solo en el
# loopback: la unica puerta de entrada desde internet es nginx, que hace de
# proxy inverso y es quien termina el TLS.
#
#   sudo cp taller-cifrado.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now taller-cifrado

[Unit]
Description=Taller de Cifrado Clasico (Angular SSR + Express)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=taller
Group=taller
WorkingDirectory=/opt/taller-cifrado
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=4000
# Hay un proxy delante: confiar en sus cabeceras es correcto en las tres etapas.
Environment=CONFIAR_EN_PROXY=1
#
# COOKIE_SECURE y FORZAR_HTTPS arrancan en false A PROPOSITO.
# La etapa 1 del taller consiste en demostrar el sitio SIN cifrado: con
# FORZAR_HTTPS=true la aplicacion redirigiria al puerto 443, donde todavia no
# escucha nadie, y el sitio quedaria inaccesible justo cuando hay que capturar
# la evidencia del trafico en claro.
# El script 01-certificado-autofirmado.sh las pone en true, mediante un archivo
# suplementario en /etc/systemd/system/taller-cifrado.service.d/https.conf,
# en cuanto existe un certificado y el puerto 443 responde.
Environment=COOKIE_SECURE=false
Environment=FORZAR_HTTPS=false
EnvironmentFile=-/opt/taller-cifrado/.env
ExecStart=/usr/bin/node dist/Taller-cifrado/server/server.mjs
Restart=on-failure
RestartSec=5

# Endurecimiento basico del servicio
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/taller-cifrado/data

[Install]
WantedBy=multi-user.target
